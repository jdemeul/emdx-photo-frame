# Copy to .env and fill in the four values marked REQUIRED.

# --- Photos ---------------------------------------------------------------
# REQUIRED: the album's share link (Google Photos → album → Share → Create link),
# i.e. https://photos.app.goo.gl/... or the full https://photos.google.com/share/...?key=... URL.
# Several albums: separate with commas.
ALBUM_URLS=https://photos.app.goo.gl/REPLACE_ME

# Optional: also use photos from a NAS folder mounted at /photos (see docker-compose.yml).
#PHOTO_DIR=/photos

# --- Display --------------------------------------------------------------
# REQUIRED: the display's IP address (give it a fixed DHCP lease in your router).
EMDX_HOST=192.168.1.50
# REQUIRED: the display's 6-digit device security PIN (set in the Samsung E-Paper app).
EMDX_PIN=000000
# Recommended: the display's MAC address, so the NAS can wake it from sleep with Wake-on-LAN.
#EMDX_MAC=00:11:22:33:44:55
# Where the Wake-on-LAN packet goes. If the display doesn't wake, try your network's
# broadcast address, e.g. 192.168.1.255.
#WOL_BROADCAST=255.255.255.255

PANEL=EM32DX
ORIENTATION=portrait
# If the test pattern shows up sideways or upside down, set 90, 180 or 270.
ROTATE=0

# --- This NAS --------------------------------------------------------------
# REQUIRED: the NAS's LAN address (the display downloads the image from it).
SERVER_HOST=192.168.1.10
# Port for the display downloads and the web page (http://SERVER_HOST:8321).
HTTP_PORT=8321
# Optional password for the web page (user name: anything).
#UI_PASSWORD=

# --- When -----------------------------------------------------------------
TZ=Europe/Brussels
# Cron syntax: minute hour day month weekday. Default: every day at 06:00.
SCHEDULE=0 6 * * *
RUN_ON_START=false

# --- Sleep (saves battery) -------------------------------------------------
# Two minutes after each update the NAS powers the display off, with its Wi-Fi
# listener (Network Standby) on so the next update can wake it with Wake-on-LAN
# (needs EMDX_MAC). Set to "off" to leave sleeping to the display's own settings.
SLEEP_MODE=standby
# Seconds to let the panel redraw before it is powered off.
#SLEEP_DELAY_SEC=120

# --- Layout ---------------------------------------------------------------
# Photos whose shape doesn't suit the frame: pair | crop | fit
ODD_PHOTOS=pair
PAIR_GAP=20

# --- Image ----------------------------------------------------------------
# device = send the photo and let the display dither it (default; looked best on an EM32DX)
# local  = dither on the NAS (gamut mapping + blue noise)
DITHER=device
# Tone tweaks before sending. Defaults: 1.0 / 0.1 with device, 1.3 / 0.25 with local.
#SATURATION=1.0
#CONTRAST=0.1
# Raise to 1.1-1.2 if photos look too dark on the panel.
GAMMA=1.0
SHARPEN=0.8

# Only used with DITHER=local:
# bluenoise (calm, no artefacts) | diffusion (classic Floyd-Steinberg etc.)
#DITHER_METHOD=bluenoise
#DITHER_KERNEL=floyd-steinberg
# Measured ink colours (used for the dithering maths); override if you measure your own panel.
#PALETTE={"black":"#1F2226","white":"#B9C7C9","red":"#62201E","yellow":"#C1BB1E","green":"#35563A","blue":"#233F8E"}
