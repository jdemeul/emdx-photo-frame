# Copy to .env and fill in the four values marked REQUIRED. The rest is the recommended setup for
# a display on battery: playlist mode with deep sleep.

# --- Photos ---------------------------------------------------------------
# REQUIRED: the album's share link (Google Photos → album → Share → Create link),
# i.e. https://photos.app.goo.gl/... or the full https://photos.google.com/share/...?key=... URL.
# Several albums: separate with commas.
ALBUM_URLS=https://photos.app.goo.gl/REPLACE_ME

# Optional: also use photos from a NAS folder mounted at /photos (see docker-compose.yml).
#PHOTO_DIR=/photos

# --- Display --------------------------------------------------------------
# REQUIRED: the display's IP address (give it a fixed DHCP lease in your router).
EMDX_HOST=192.168.1.50
# REQUIRED: the display's 6-digit device security PIN (set in the Samsung E-Paper app).
EMDX_PIN=000000

PANEL=EM32DX
ORIENTATION=portrait
# If the test pattern shows up sideways or upside down, set 90, 180 or 270.
ROTATE=0

# --- This NAS --------------------------------------------------------------
# REQUIRED: the NAS's LAN address (the display downloads the photos from it).
SERVER_HOST=192.168.1.10
# Port for the display downloads and the web page (http://SERVER_HOST:8321).
HTTP_PORT=8321
# Optional password for the web page (user name: anything).
#UI_PASSWORD=

# --- When and how the photo changes -----------------------------------------
TZ=Europe/Brussels
# Cron syntax: minute hour day month weekday. Every day at 06:00:
SCHEDULE=0 6 * * *
#   playlist: the NAS sends the photos for the coming days at once, and the display changes
#             them itself, also in deep sleep. Best on battery.
#   push:     the NAS sends each photo at SCHEDULE; the display must be reachable then (mains
#             power, or SLEEP_MODE=standby with Wake-on-LAN).
UPDATE_MODE=playlist
# Playlist mode: days per playlist (1-60; each photo is a 2-4 MB PNG for the display).
PLAYLIST_DAYS=7
# When a fresh playlist goes out:
#   every-change: after every change, while the display is briefly online. Keeps an EM32DX on
#                 battery changing: left alone after a change, it got stuck in its panel cleaning
#                 before the next one.
#   when-short:   only once fewer than PLAYLIST_TOPUP_DAYS days are left on the display.
#PLAYLIST_RESEND=every-change
#PLAYLIST_TOPUP_DAYS=7

# --- Sleep (saves battery) -------------------------------------------------
# After each update the NAS powers the display off and checks that it went to sleep.
#   deep:    its Wi-Fi listener (network standby) off too: hardly any battery use, but nothing on
#            the network wakes it. Best with UPDATE_MODE=playlist.
#   standby: network standby stays on, so Wake-on-LAN (needs EMDX_MAC) can wake it any time.
#            About 1.5% battery an hour; on battery it stops hearing Wake-on-LAN after many hours.
#   off:     leave sleeping to the display's own settings (e.g. on mains power).
SLEEP_MODE=deep
# For Wake-on-LAN (standby): the display's MAC address, and where the packet goes (try your
# network's broadcast address, e.g. 192.168.1.255, if the display doesn't wake).
#EMDX_MAC=00:11:22:33:44:55
#WOL_BROADCAST=255.255.255.255
# Seconds to let the panel redraw before it is powered off.
#SLEEP_DELAY_SEC=120
# Every this many minutes, check (without waking it) that the display is still asleep, and off the
# Wi-Fi in deep sleep. 0 = never.
#SLEEP_CHECK_MIN=30
# Playlist mode: how long the NAS looks for the display after each change.
#WAKE_WINDOW_MIN=15
# Playlist mode: after a change the display missed, look for it every this many seconds (without
# waking it) and send it a fresh playlist once it answers. 0 = only at the sleep checks.
#MISSED_CHECK_SEC=60
# The display's daily panel cleaning (its "screen protection" time in the Samsung E-Paper app).
# The NAS reads it from the display; set it here only if the page says the display doesn't tell.
# Best just before the change (e.g. 05:50 for a 06:00 change).
#CLEANING_TIME=05:50
# Send a photo (push mode) or a due playlist (playlist mode) as soon as the service starts.
#RUN_ON_START=false

# --- Notifications and more frames -------------------------------------------
# Post a line of text here when the frame needs a hand (missed change, low battery, no deep
# sleep) and when it is fine again. Made for ntfy: https://ntfy.sh/<a-topic-nobody-will-guess>
#NOTIFY_URL=
# The frame's name on the page.
#FRAME_NAME=Photo frame
# Several displays: name them, and put a frame's name in front of the settings that are its own
# (see the README). The first one takes over the state of the single frame you had.
#FRAMES=hall,kitchen
#HALL_EMDX_HOST=192.168.1.50
#KITCHEN_EMDX_HOST=192.168.1.51
#KITCHEN_NAME=Kitchen

# --- Layout ---------------------------------------------------------------
# Photos whose shape doesn't suit the frame: pair | crop | fit
ODD_PHOTOS=pair
PAIR_GAP=20

# --- Image ----------------------------------------------------------------
# device = send the photo and let the display dither it (default; looked best on an EM32DX)
# local  = dither on the NAS (gamut mapping + blue noise)
DITHER=device
# Tone tweaks before sending. Defaults: 1.0 / 0.1 with device, 1.3 / 0.25 with local.
#SATURATION=1.0
#CONTRAST=0.1
# Raise to 1.1-1.2 if photos look too dark on the panel.
GAMMA=1.0
SHARPEN=0.8

# Only used with DITHER=local:
# bluenoise (calm, no artefacts) | diffusion (classic Floyd-Steinberg etc.)
#DITHER_METHOD=bluenoise
#DITHER_KERNEL=floyd-steinberg
# Measured ink colours (used for the dithering maths); override if you measure your own panel.
#PALETTE={"black":"#1F2226","white":"#B9C7C9","red":"#62201E","yellow":"#C1BB1E","green":"#35563A","blue":"#233F8E"}
